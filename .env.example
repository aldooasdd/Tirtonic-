# --- Supabase Postgres (Project Settings > Database > Connection string) ---
# Pooled connection (used by the app at runtime). Add ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (used by Prisma migrate / db push)
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxx.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."   # server-only, never expose
SUPABASE_STORAGE_BUCKET="tirtonic"                  # create a PUBLIC bucket with this name

# --- Admin auth (single admin) ---
ADMIN_PASSWORD="ganti-password-ini"
SESSION_SECRET="isi-string-acak-panjang"            # e.g. `openssl rand -hex 32`

# --- WhatsApp order (international format, no + or leading 0) ---
NEXT_PUBLIC_ADMIN_WA="6285163215511"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/tirtonic"
