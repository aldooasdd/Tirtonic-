# --- Supabase Postgres (Project Settings > Database > Connection string) ---
# Pooled connection (used by the app at runtime). Add ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (used by Prisma migrate / db push)
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxx.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."   # server-only, never expose
SUPABASE_STORAGE_BUCKET="tirtonic"                  # create a PUBLIC bucket with this name

# --- Admin auth (single admin) ---
ADMIN_PASSWORD="ganti-password-ini"
SESSION_SECRET="isi-string-acak-panjang"            # e.g. `openssl rand -hex 32`

# --- WhatsApp order (international format, no + or leading 0) ---
NEXT_PUBLIC_ADMIN_WA="6285163215511"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/tirtonic"

# --- URL situs (dipakai untuk callback DOKU & link order di webhook n8n) ---
NEXT_PUBLIC_SITE_URL="https://tirtonic.com"

# --- DOKU (payment gateway). Kosongkan dulu kalau belum punya akun:
#     order tetap dibuat (PENDING) & bisa dikonfirmasi manual oleh admin.
#     Isi saat akun siap → pembayaran online otomatis aktif. ---
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
DOKU_BASE_URL="https://api-sandbox.doku.com"          # production: https://api.doku.com

# --- Biteship (cek ongkir real-time, banyak kurir). Kosong = pakai ongkir flat
#     (SHIPPING_OPTIONS di constants.ts) sebagai fallback. ---
BITESHIP_API_KEY=""
BITESHIP_ORIGIN_POSTAL_CODE=""                        # kode pos gudang/toko (asal kirim)
BITESHIP_COURIERS="jne,jnt,sicepat,anteraja,pos,ninja" # opsional, daftar kurir

# --- n8n webhooks (WA + email otomatis diproses di n8n, bukan di web ini).
#     Kosong = tidak kirim apa-apa (aman). ---
N8N_ORDER_PAID_URL=""                                 # dipanggil saat pesanan LUNAS
N8N_ORDER_SHIPPED_URL=""                              # dipanggil saat resi diisi (kirim WA resi)
N8N_WEBHOOK_SECRET=""                                 # opsional: dikirim sbg header x-webhook-secret
