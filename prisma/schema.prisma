generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StockStatus {
  READY
  SOLD
}

enum OrderStatus {
  PENDING // dibuat, menunggu pembayaran
  PAID // sudah dibayar (via DOKU / konfirmasi manual)
  SHIPPED // sudah dikirim (resi diisi)
  DELIVERED // sudah diterima customer (admin tandai) → boleh dinilai
  CANCELLED // dibatalkan
}

// ── Pre-order ───────────────────────────────────────────────────────────────
// Produk PO: customer bayar DP dulu (min 100rb, via DOKU), barang menyusul.
model PreorderProduct {
  id        String          @id @default(cuid())
  nama      String
  tagline   String? // subjudul hero landing, mis. "Hello, hello."
  slogan    String? // slogan pendek di bawah nama produk (hero landing)
  launchAt  DateTime? // tanggal hari-H launching (buat countdown di hero)
  harga     Int // harga penuh
  gambar    String[]        @default([]) // foto produk (galeri di halaman detail)
  bannerDesktop String? // (lama) foto hero desktop tunggal — fallback
  bannerMobile  String? // (lama) foto hero HP tunggal — fallback
  bannersDesktop String[] @default([]) // slide hero desktop (beberapa foto)
  bannersMobile  String[] @default([]) // slide hero HP (beberapa foto)
  lunasBenefits  String[] @default([]) // benefit khusus kalau bayar lunas (satu per baris)
  kuota          Int?     // total slot PO (buat hitungan "X/kuota" di landing). null = tanpa batas
  dpMin          Int      @default(100000) // DP minimal. 0 = tanpa minimum (DP bebas)
  showOnLanding  Boolean  @default(true) // tampil di hero landing. false = cuma di halaman /preorder
  varianLabel    String?  // nama atribut varian bebas (mis. "Warna", "Ukuran", "Edisi")
  sizeChart      String?  // foto panduan ukuran (size chart), tampil samping pilih ukuran
  deskripsi String?
  bonusNama      String? // bonus jika bayar penuh (lunas) di awal: nama
  bonusDeskripsi String? // bonus: deskripsi
  bonusFoto      String? // bonus: foto
  isiBox    String[]        @default([]) // "What's in the Box" — daftar isi kotak
  estimasi  String? // mis. "Tiba akhir November"
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  orders    PreorderOrder[]
  variants  PreorderVariant[]
}

// Varian produk PO (opsional). Kalau ada, customer wajib pilih; harga & stok per varian.
model PreorderVariant {
  id        String          @id @default(cuid())
  productId String
  product   PreorderProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  warna     String
  ukuran    String? // opsional
  harga     Int
  stok      Int             @default(0)
  gambar    String? // foto warna
  urutan    Int             @default(0)

  @@index([productId])
}

enum PreorderStatus {
  PENDING_DP // dibuat, DP belum dibayar
  DP_PAID // DP lunas, menunggu barang
  WAITING_LUNAS // barang ready, kekurangan dikirim, menunggu pelunasan
  LUNAS // lunas (bayar penuh di awal / DP dilunasi), menunggu tiba/kirim
  SHIPPED // sudah dikirim (resi diinput) / sudah diambil
  CANCELLED
}

model PreorderOrder {
  id              String           @id @default(cuid())
  invoice         String           @unique // PO-YYMMDD-XXXX (referensi DOKU untuk DP)
  invoiceLunas    String?          @unique // referensi DOKU untuk pelunasan (dibuat saat barang ready)
  nama            String
  email           String
  telepon         String
  alamat          String
  kota            String
  provinsi        String
  kodePos         String?
  catatan         String?
  productId       String?
  productNama     String // snapshot
  variantId       String?
  varian          String? // snapshot label varian
  gambar          String?
  harga           Int // satuan snapshot
  qty             Int
  total           Int // harga * qty
  dp              Int // uang muka dibayar
  kekurangan      Int? // diisi admin saat barang ready (default total - dp)
  estimasi        String? // snapshot estimasi tiba produk
  status          PreorderStatus   @default(PENDING_DP)
  paymentRefDp    String?
  paymentRefLunas String?
  lunasUrl        String? // link DOKU pelunasan (dipakai ulang di pengingat)
  batasPelunasan  DateTime? // deadline pelunasan (ready + 7 hari)
  reminderSentAt  DateTime? // pengingat H-2 sudah dikirim
  kurir           String?
  resi            String?
  dpPaidAt        DateTime?
  readyAt         DateTime?
  arrivedAt       DateTime? // barang tiba utk pembeli lunas-di-awal
  lunasAt         DateTime?
  shippedAt       DateTime?
  product         PreorderProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@index([telepon])
}

// Pesanan checkout (guest, tanpa login). Pembayaran via DOKU (dipasang via env),
// atau dikonfirmasi manual oleh admin. Nomor resi hanya disimpan & dikirim ke
// customer (lewat webhook n8n); pelacakannya tetap di situs kurir.
model Order {
  id          String      @id @default(cuid())
  invoice     String      @unique // TIRT-YYMMDD-XXXX, dipakai juga sebagai referensi DOKU
  nama        String
  email       String
  telepon     String
  alamat      String
  kota        String
  provinsi    String
  kodePos     String?
  catatan     String?
  kurir       String // opsi pengiriman yang dipilih (label + estimasi)
  ongkir      Int
  subtotal    Int
  diskon      Int         @default(0) // potongan dari kupon
  kupon       String? // kode kupon yang dipakai
  total       Int
  status      OrderStatus @default(PENDING)
  resi        String?
  metodeBayar String? // diisi dari DOKU (VA / QRIS / dll)
  paymentRef  String? // referensi transaksi DOKU
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime? // diisi saat admin tandai pesanan diterima
  items       OrderItem[]
  reviews     Review[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Penilaian produk oleh customer, hanya setelah pesanan DELIVERED.
// Satu baris per produk per pesanan (cegah dobel lewat @@unique).
model Review {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String? // referensi; snapshot nama disimpan terpisah karena produk bisa terhapus
  productNama String
  rating      Int // 1–5
  komentar    String?
  createdAt   DateTime @default(now())

  @@unique([orderId, productNama])
  @@index([productId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String? // referensi (produk bisa berubah/terhapus nanti)
  variantId String?
  nama      String // snapshot nama produk saat dibeli
  varian    String? // snapshot varian, mis. "Biru / 1.20mm"
  harga     Int // snapshot harga satuan (sudah termasuk diskon) saat dibeli
  qty       Int
  gambar    String?

  @@index([orderId])
}

model Product {
  id        String      @id @default(cuid())
  nama      String
  kategori  String // Sepatu Tenis | Raket Tenis | String & Grip | Tas & Aksesoris | Bola Tenis
  brand     String?
  harga     Int // rupiah, whole number (harga normal)
  hargaDiskon Int? // harga diskon (opsional); jika < harga → tampil coret + badge
  diskonPersen Int @default(0) // diskon se-produk (%), berlaku ke semua varian; 0 = tanpa diskon
  eventAktif Boolean @default(false) // ikut event/promo → tampil di filter "Promo" shop
  eventCarousel Boolean @default(false) // tampil di carousel event landing page
  eventNama String? // nama promo/event (judul carousel landing)
  berat     Int @default(500) // berat satuan (gram), untuk hitung ongkir
  deskripsi String?
  gambar    String[] // image URLs (Supabase Storage)
  sizeChart String? // size chart image URL (from Tokopedia import or manual)
  ukuran    String[] // shoe sizes, only for Sepatu Tenis
  status    StockStatus @default(READY)
  stok      Int?        // stok produk non-varian (null = tak terbatas; 0 = habis). Produk bervarian pakai stok per-varian.
  views     Int         @default(0) // product-page view counter
  variants  ProductVariant[]
  twuStrings TwuString[] // String Finder: senar TWU yg pakai produk ini sbg sumber harga/stok
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// A color+size combo with its own price, stock and (per-color) photo.
// A product with zero variants behaves as before (single harga + optional ukuran).
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warna     String // color name, e.g. "Biru"
  ukuran    String  @default("") // second axis, e.g. "1.20mm"; "" if the product has no size axis
  harga     Int // rupiah for this combo (harga normal)
  hargaDiskon Int? // harga diskon (opsional); jika < harga → tampil coret + badge
  stok      Int     @default(0)
  gambar    String? // photo for this color (Supabase Storage URL)
  urutan    Int     @default(0)

  @@index([productId])
}

model Article {
  id        String   @id @default(cuid())
  slug      String?  @unique // URL ramah-SEO (dari judul); null → fallback ke id
  judul     String
  tag       String? // e.g. "News, Tennis Racket"
  penulis   String   @default("admin")
  tanggal   DateTime @default(now())
  gambar    String?
  excerpt   String?
  konten    String
  createdAt DateTime @default(now())
}

model HeroSlide {
  id           String   @id @default(cuid())
  gambar       String // desktop (wide, ~2.6:1)
  gambarMobile String? // optional mobile (square, ~1:1); falls back to gambar
  link         String?
  urutan       Int      @default(0)
  createdAt    DateTime @default(now())
}

// Carousel "Brand Popular" di landing. Klik → /shop?brand=<nama>. Admin isi
// nama brand + foto (lihat src/app/dashboard panel Brand Popular).
model PopularBrand {
  id     String @id @default(cuid())
  nama   String // nama brand, dipakai juga sebagai nilai filter ?brand=
  foto   String // URL foto (Supabase Storage)
  urutan Int    @default(0)
}

model Store {
  id      String  @id @default(cuid())
  nama    String // Yogyakarta | Solo
  alamat  String
  jam     String?
  foto    String? // square photo (1080x1080)
  maps    String? // Google Maps link
  urutan  Int     @default(0)
}

model SponsorshipSubmission {
  id String @id @default(cuid())
  // 1. Penyelenggara
  organisasi      String
  penanggungJawab String
  noWa            String
  email           String
  // 2. Event
  namaEvent    String?
  jenisEvent   String[] // Turnamen | Coaching Clinic | Ekshibisi | Lainnya
  tanggalEvent String?
  alamatEvent  String?
  kota         String?
  // 3. Proposal
  ringkasan    String?
  proposalFile String? // uploaded PDF/Docs URL
  // 4. Bentuk sponsorship
  bentuk String[] // Produk | Hadiah Turnamen | Uang Tunai | Publikasi/Promosi | Lainnya
  // 5. Manfaat
  eksposur String?
  catatan  String?
  createdAt DateTime @default(now())
}

// ponytail: no Admin table — single admin via ADMIN_PASSWORD env var (see lib/auth.ts).
// Add a hashed-password table only if multi-admin is ever needed.

// ============================================================================
// String Finder (lihat docs/string-finder/). Harga & stok senar TIDAK disimpan
// di sini — diambil live dari Product via TwuString.productId (satu sumber).
// ============================================================================

enum SfJobStatus {
  antri
  terkirim
  gagal
  kedaluwarsa
}

enum SfOrderStatus {
  antri // menunggu stringer
  dikerjakan // stringer sedang mengerjakan
  selesai // senar siap diambil
  batal
}

model TwuString {
  id             String           @id @default(cuid())
  name           String           @unique
  family         String
  material       String
  gaugeMm        Float?
  dataCoverage   String // lengkap | referensi_51F | tanpa_data
  datasetVersion String
  productId      String? // join ke Product (sumber harga + stok). null = belum terpetakan
  product        Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  measurements   TwuMeasurement[]

  @@index([family])
  @@index([productId])
}

model TwuMeasurement {
  id              String    @id @default(cuid())
  stringId        String
  string          TwuString @relation(fields: [stringId], references: [id], onDelete: Cascade)
  tensionLbs      Int // 40 | 51 | 62
  swing           String // "S" | "M" | "F"
  stiffnessLbIn   Float? // st
  tensionLossPct  Float? // tl
  energyReturnPct Float? // er
  dwellTimeMs     Float? // dw
  spinPotential   Float? // sp

  @@unique([stringId, tensionLbs, swing])
}

model SfRuleSet {
  id        String   @id @default(cuid())
  version   Int      @unique
  config    Json // isi rules.json apa adanya
  isActive  Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  @@index([isActive])
}

model SfBranch {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  accessCode        String?      @unique // kode login kiosk stringer per cabang
  paperMm           String       @default("58") // "58" | "80"
  etaMinutes        Int          @default(30)
  isActive          Boolean      @default(true)
  stationLastSeenAt DateTime?
  results           SfResult[]
  printJobs         SfPrintJob[]
  orders            SfOrder[]
}

model SfResult {
  code           String       @id // SF-XXXX
  createdAt      DateTime     @default(now())
  branchId       String?
  branch         SfBranch?    @relation(fields: [branchId], references: [id])
  answers        Json
  condition      String
  ruleVersion    Int
  datasetVersion String
  picks          Json
  chosenRank     Int?
  printJobs      SfPrintJob[]
  orders         SfOrder[]

  @@index([createdAt])
  @@index([branchId])
}

model SfOrder {
  id           String        @id @default(cuid())
  resultCode   String
  result       SfResult      @relation(fields: [resultCode], references: [code])
  branchId     String
  branch       SfBranch      @relation(fields: [branchId], references: [id])
  phone        String
  customerName String?
  chosenRank   Int?
  chosenString String?
  tensionLbs   Int? // tarikan Main (lbs) — saran finder, bisa diubah customer
  tensionCrossLbs Int? // tarikan Cross (lbs) — saran finder (biasanya Main −2), bisa diubah
  racket       String? // label raket dari finder, mis. "Power · 100 in²" (head size + jenis)
  stringerName String? // nama stringer yang mengerjakan — wajib diisi saat mulai kerjakan
  price        Int? // total harga senar (rupiah) saat order — untuk kasir
  paidAt       DateTime? // waktu dibayar/lunas (null = belum lunas). Bayar dulu baru dikerjakan.
  status       SfOrderStatus @default(antri)
  etaMinutes   Int           @default(30)
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  notifiedInAt DateTime?
  notifiedDone DateTime?

  @@index([branchId, status])
  @@index([createdAt])
}

// Hadiah leaderboard: 1 baris per pemenang (rank 1-3) per periode (YYYY-MM, Global).
// Dibuat oleh cron saat periode berakhir → WA klaim. Ditukar sekali di toko manapun
// (stringer scan QR di dashboard mereka). redeemedAt != null = sudah ditukar.
model Reward {
  id         String    @id @default(cuid())
  phone      String
  name       String?
  period     String // "YYYY-MM"
  rank       Int // 1,2,3
  prize      String // teks hadiah
  notifiedAt DateTime? // kapan WA klaim dikirim
  redeemedAt DateTime? // kapan ditukar di toko (null = belum)
  redeemedBy String? // role/cabang yang scan
  createdAt  DateTime  @default(now())

  // Klaim via OTP WA: pemenang verifikasi OTP, pilih item hadiah, baru QR muncul.
  claimOtpHash  String? // sha256(secret + kode OTP)
  claimOtpExp   DateTime? // kadaluarsa OTP
  claimOtpTries Int       @default(0) // percobaan salah; dikunci setelah 5
  claimVerified DateTime? // kapan OTP terverifikasi (izin pilih item)
  claimItems    String? // item hadiah terpilih, dipisah " + "

  @@unique([period, rank])
  @@index([phone])
}

// Keanggotaan loyalty (Ace Points). Dikelola admin di /dashboard/member.
// Earning/tier dasar dihitung dari invoice Tirtonichub; di sini cuma flag yang
// tak bisa disimpulkan dari belanja: coach (Green), undangan Privé, perujuk, ultah.
// phone = 62xxxx (dinormalkan). coachCode = kode referral coach (Green).
// referredBy = coachCode perujuk member ini (murid → coach).
model Member {
  phone        String    @id
  name         String?
  isCoach      Boolean   @default(false)
  coachCode    String?   @unique
  invitedPrive Boolean   @default(false)
  referredBy   String?
  birthday     DateTime?
  createdAt    DateTime  @default(now())

  @@index([referredBy])
}

model SfPrintJob {
  id          String      @id @default(cuid())
  resultCode  String
  result      SfResult    @relation(fields: [resultCode], references: [code])
  branchId    String
  branch      SfBranch    @relation(fields: [branchId], references: [id])
  chosenRank  Int?
  status      SfJobStatus @default(antri)
  createdAt   DateTime    @default(now())
  sentAt      DateTime?
  attempts    Int         @default(0)
  error       String?
  requestedBy String // "device" | "admin"

  @@index([branchId, status])
  @@index([createdAt])
}

model SfLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  scope     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}


// Kupon diskon di checkout. Potongan selalu persen (value = 1-100). productIds
// kosong = berlaku semua produk; terisi = hanya produk tertentu. Produk yang
// sudah diskon (hargaDiskon < harga) tidak pernah ikut dipotong — logika itu
// ada di src/lib/coupons.ts.
model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique // selalu disimpan UPPERCASE
  type       String   @default("percent") // "percent" (value = 1-100) | "amount" (value = rupiah)
  value      Int // persen potongan (1-100) ATAU nominal rupiah, tergantung type
  productIds String[] @default([]) // batasi ke produk tertentu
  categories String[] @default([]) // batasi ke kategori tertentu (semua produk kategori ini, termasuk produk baru)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// Override kata sandi per role (hasil "ganti kata sandi" di dashboard). Kalau
// baris untuk suatu role ada, password-nya dipakai menggantikan default di
// src/lib/roles.ts. Format hash: "<salt>:<scrypt>" (lihat src/lib/role-password.ts).
model RolePassword {
  role      String   @id // key role, mis. "bos", "admin"
  hash      String
  updatedAt DateTime @updatedAt
}

// ──────────────── Event Demo Produk (brand → komunitas) ────────────────

// Akun komunitas tenis wilayah. Password = instagram + 3 angka (dikirim via WA).
model Community {
  id           String      @id @default(cuid())
  name         String
  logo         String?
  waPhone      String // 62xxx — penanggung jawab komunitas
  instagram    String      @unique // username tanpa @
  passwordHash String      @default("") // diisi saat admin meng-ACC (password dikirim via WA)
  status       String      @default("pending") // pending | accepted | rejected — harus di-ACC admin dulu
  createdAt    DateTime    @default(now())
  claims       DemoClaim[]
}

// Kampanye demo yang dibuat toko (brand, produk, periode). Komunitas mengklaim ini.
model DemoCampaign {
  id          String      @id @default(cuid())
  brand       String
  productType String // jenis produk yang didemokan
  title       String
  description String
  banner       String?
  startDate    DateTime? // periode tersedia (mulai) — diisi saat ACC brand
  endDate      DateTime? // periode tersedia (selesai) — diisi saat ACC brand
  isActive     Boolean     @default(true)
  brandApproved Boolean    @default(false) // true = sudah di-ACC brand → "Now" (siap diklaim); false = masih rencana → "Coming soon"
  createdAt    DateTime    @default(now())
  claims       DemoClaim[]
}

// Klaim demo oleh komunitas atas sebuah kampanye → jadi acara setelah di-ACC toko.
model DemoClaim {
  id            String            @id @default(cuid())
  campaignId    String
  campaign      DemoCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  communityId   String
  community     Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  court         String // lapangan tenis
  quotaType     String // "closed" (kuota fix) | "open" (orang bisa join dari web)
  quota         Int // minimal 10 — kuota sesi ini
  demoDate      DateTime // tanggal sesi
  time          String   @default("") // jam mulai "HH:mm" (1 card = 1 sesi)
  timeEnd       String   @default("") // jam selesai "HH:mm"
  eventPicPhone String // 62xxx — penanggung jawab acara
  status        String            @default("pending") // pending | accepted | rejected
  lat           Float?    // koordinat lapangan (dari saran OpenStreetMap) — untuk peta OSM
  lng           Float?
  pickedUpAt    DateTime? // waktu produk demo diambil komunitas (via scan QR admin)
  returnedAt    DateTime? // waktu produk demo dikembalikan ke toko (via scan QR admin)
  createdAt     DateTime          @default(now())
  participants  DemoParticipant[]

  @@index([status])
  @@index([communityId])
}

// Peserta yang join acara demo "open" dari web — perlu di-ACC komunitas.
model DemoParticipant {
  id        String    @id @default(cuid())
  claimId   String
  claim     DemoClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  name      String
  phone     String // 62xxx
  status    String    @default("pending") // pending | accepted | rejected
  createdAt DateTime  @default(now())

  @@index([claimId])
}

