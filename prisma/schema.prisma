generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StockStatus {
  READY
  SOLD
}

enum OrderStatus {
  PENDING // dibuat, menunggu pembayaran
  PAID // sudah dibayar (via DOKU / konfirmasi manual)
  SHIPPED // sudah dikirim (resi diisi)
  CANCELLED // dibatalkan
}

// Pesanan checkout (guest, tanpa login). Pembayaran via DOKU (dipasang via env),
// atau dikonfirmasi manual oleh admin. Nomor resi hanya disimpan & dikirim ke
// customer (lewat webhook n8n); pelacakannya tetap di situs kurir.
model Order {
  id          String      @id @default(cuid())
  invoice     String      @unique // TIRT-YYMMDD-XXXX, dipakai juga sebagai referensi DOKU
  nama        String
  email       String
  telepon     String
  alamat      String
  kota        String
  provinsi    String
  kodePos     String?
  catatan     String?
  kurir       String // opsi pengiriman yang dipilih (label + estimasi)
  ongkir      Int
  subtotal    Int
  diskon      Int         @default(0) // potongan dari kupon
  kupon       String? // kode kupon yang dipakai
  total       Int
  status      OrderStatus @default(PENDING)
  resi        String?
  metodeBayar String? // diisi dari DOKU (VA / QRIS / dll)
  paymentRef  String? // referensi transaksi DOKU
  paidAt      DateTime?
  shippedAt   DateTime?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String? // referensi (produk bisa berubah/terhapus nanti)
  variantId String?
  nama      String // snapshot nama produk saat dibeli
  varian    String? // snapshot varian, mis. "Biru / 1.20mm"
  harga     Int // snapshot harga satuan (sudah termasuk diskon) saat dibeli
  qty       Int
  gambar    String?

  @@index([orderId])
}

model Product {
  id        String      @id @default(cuid())
  nama      String
  kategori  String // Sepatu Tenis | Raket Tenis | String & Grip | Tas & Aksesoris | Bola Tenis
  brand     String?
  harga     Int // rupiah, whole number (harga normal)
  hargaDiskon Int? // harga diskon (opsional); jika < harga → tampil coret + badge
  diskonPersen Int @default(0) // diskon se-produk (%), berlaku ke semua varian; 0 = tanpa diskon
  berat     Int @default(500) // berat satuan (gram), untuk hitung ongkir
  deskripsi String?
  gambar    String[] // image URLs (Supabase Storage)
  sizeChart String? // size chart image URL (from Tokopedia import or manual)
  ukuran    String[] // shoe sizes, only for Sepatu Tenis
  status    StockStatus @default(READY)
  stok      Int?        // stok produk non-varian (null = tak terbatas; 0 = habis). Produk bervarian pakai stok per-varian.
  views     Int         @default(0) // product-page view counter
  variants  ProductVariant[]
  twuStrings TwuString[] // String Finder: senar TWU yg pakai produk ini sbg sumber harga/stok
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// A color+size combo with its own price, stock and (per-color) photo.
// A product with zero variants behaves as before (single harga + optional ukuran).
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warna     String // color name, e.g. "Biru"
  ukuran    String  @default("") // second axis, e.g. "1.20mm"; "" if the product has no size axis
  harga     Int // rupiah for this combo (harga normal)
  hargaDiskon Int? // harga diskon (opsional); jika < harga → tampil coret + badge
  stok      Int     @default(0)
  gambar    String? // photo for this color (Supabase Storage URL)
  urutan    Int     @default(0)

  @@index([productId])
}

model Article {
  id        String   @id @default(cuid())
  judul     String
  tag       String? // e.g. "News, Tennis Racket"
  penulis   String   @default("admin")
  tanggal   DateTime @default(now())
  gambar    String?
  excerpt   String?
  konten    String
  createdAt DateTime @default(now())
}

model HeroSlide {
  id           String   @id @default(cuid())
  gambar       String // desktop (wide, ~2.6:1)
  gambarMobile String? // optional mobile (square, ~1:1); falls back to gambar
  link         String?
  urutan       Int      @default(0)
  createdAt    DateTime @default(now())
}

model Store {
  id      String  @id @default(cuid())
  nama    String // Yogyakarta | Solo
  alamat  String
  jam     String?
  foto    String? // square photo (1080x1080)
  maps    String? // Google Maps link
  urutan  Int     @default(0)
}

model SponsorshipSubmission {
  id String @id @default(cuid())
  // 1. Penyelenggara
  organisasi      String
  penanggungJawab String
  noWa            String
  email           String
  // 2. Event
  namaEvent    String?
  jenisEvent   String[] // Turnamen | Coaching Clinic | Ekshibisi | Lainnya
  tanggalEvent String?
  alamatEvent  String?
  kota         String?
  // 3. Proposal
  ringkasan    String?
  proposalFile String? // uploaded PDF/Docs URL
  // 4. Bentuk sponsorship
  bentuk String[] // Produk | Hadiah Turnamen | Uang Tunai | Publikasi/Promosi | Lainnya
  // 5. Manfaat
  eksposur String?
  catatan  String?
  createdAt DateTime @default(now())
}

// ponytail: no Admin table — single admin via ADMIN_PASSWORD env var (see lib/auth.ts).
// Add a hashed-password table only if multi-admin is ever needed.

// ============================================================================
// String Finder (lihat docs/string-finder/). Harga & stok senar TIDAK disimpan
// di sini — diambil live dari Product via TwuString.productId (satu sumber).
// ============================================================================

enum SfJobStatus {
  antri
  terkirim
  gagal
  kedaluwarsa
}

enum SfOrderStatus {
  antri // menunggu stringer
  dikerjakan // stringer sedang mengerjakan
  selesai // senar siap diambil
  batal
}

model TwuString {
  id             String           @id @default(cuid())
  name           String           @unique
  family         String
  material       String
  gaugeMm        Float?
  dataCoverage   String // lengkap | referensi_51F | tanpa_data
  datasetVersion String
  productId      String? // join ke Product (sumber harga + stok). null = belum terpetakan
  product        Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  measurements   TwuMeasurement[]

  @@index([family])
  @@index([productId])
}

model TwuMeasurement {
  id              String    @id @default(cuid())
  stringId        String
  string          TwuString @relation(fields: [stringId], references: [id], onDelete: Cascade)
  tensionLbs      Int // 40 | 51 | 62
  swing           String // "S" | "M" | "F"
  stiffnessLbIn   Float? // st
  tensionLossPct  Float? // tl
  energyReturnPct Float? // er
  dwellTimeMs     Float? // dw
  spinPotential   Float? // sp

  @@unique([stringId, tensionLbs, swing])
}

model SfRuleSet {
  id        String   @id @default(cuid())
  version   Int      @unique
  config    Json // isi rules.json apa adanya
  isActive  Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  @@index([isActive])
}

model SfBranch {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  paperMm           String       @default("58") // "58" | "80"
  etaMinutes        Int          @default(30)
  isActive          Boolean      @default(true)
  stationLastSeenAt DateTime?
  results           SfResult[]
  printJobs         SfPrintJob[]
  orders            SfOrder[]
}

model SfResult {
  code           String       @id // SF-XXXX
  createdAt      DateTime     @default(now())
  branchId       String?
  branch         SfBranch?    @relation(fields: [branchId], references: [id])
  answers        Json
  condition      String
  ruleVersion    Int
  datasetVersion String
  picks          Json
  chosenRank     Int?
  printJobs      SfPrintJob[]
  orders         SfOrder[]

  @@index([createdAt])
  @@index([branchId])
}

model SfOrder {
  id           String        @id @default(cuid())
  resultCode   String
  result       SfResult      @relation(fields: [resultCode], references: [code])
  branchId     String
  branch       SfBranch      @relation(fields: [branchId], references: [id])
  phone        String
  customerName String?
  chosenRank   Int?
  chosenString String?
  tensionLbs   Int? // tarikan senar (lbs) — saran finder, bisa diubah customer
  racket       String? // jenis raket (teks bebas; nanti dari daftar raket TWU)
  status       SfOrderStatus @default(antri)
  etaMinutes   Int           @default(30)
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  notifiedInAt DateTime?
  notifiedDone DateTime?

  @@index([branchId, status])
  @@index([createdAt])
}

model SfPrintJob {
  id          String      @id @default(cuid())
  resultCode  String
  result      SfResult    @relation(fields: [resultCode], references: [code])
  branchId    String
  branch      SfBranch    @relation(fields: [branchId], references: [id])
  chosenRank  Int?
  status      SfJobStatus @default(antri)
  createdAt   DateTime    @default(now())
  sentAt      DateTime?
  attempts    Int         @default(0)
  error       String?
  requestedBy String // "device" | "admin"

  @@index([branchId, status])
  @@index([createdAt])
}

model SfLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  scope     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}


// Kupon diskon di checkout. Potongan selalu persen (value = 1-100). productIds
// kosong = berlaku semua produk; terisi = hanya produk tertentu. Produk yang
// sudah diskon (hargaDiskon < harga) tidak pernah ikut dipotong — logika itu
// ada di src/lib/coupons.ts.
model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique // selalu disimpan UPPERCASE
  value      Int // persen potongan, 1-100
  productIds String[] @default([])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}
