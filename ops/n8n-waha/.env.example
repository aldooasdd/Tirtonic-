# Salin ke .env lalu isi. JANGAN commit .env (sudah di-ignore).

# --- Domain publik (arahkan A record ke IP VPS lebih dulu) ---
N8N_HOST=n8n.tirtonic.com
WAHA_HOST=waha.tirtonic.com

# --- n8n ---
# Kunci enkripsi kredensial n8n. Generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# --- WAHA (WhatsApp HTTP API) ---
# String acak bebas; dikirim sebagai header X-Api-Key dari n8n ke WAHA.
WAHA_API_KEY=
# Login dashboard WAHA (buat scan QR / cek sesi)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=ganti-password-ini
