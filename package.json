{
  "name": "tirtonic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "test:sf": "node --import tsx --test tests/engine.test.ts tests/slip.test.ts tests/phone.test.ts",
    "test:sf:db": "node --env-file-if-exists=.env --import tsx --test tests/db.test.ts",
    "sf:import": "node --env-file-if-exists=.env --import tsx scripts/sf-import.ts",
    "sf:seed": "node --env-file-if-exists=.env --import tsx scripts/sf-seed.ts",
    "sf:rackets": "node --env-file-if-exists=.env --import tsx scripts/sf-rackets.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.45.4",
    "@types/qrcode": "^1.5.6",
    "jose": "^6.2.12",
    "lottie-react": "^2.4.1",
    "next": "^14.2.33",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5"
  }
}
